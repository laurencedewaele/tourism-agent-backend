# --- Agent ---
# OBLIGATOIRES : l'application plante au démarrage si elles sont absentes
OPENROUTER_API_KEY=
MODEL_NAME=
# Longueur max (en caractères) d'un message utilisateur ; les messages plus longs sont rejetés avant tout appel au LLM
MAX_USER_MESSAGE_LENGTH=300

# --- PostgreSQL (docker compose) ---
# Lues par docker-compose.yml pour créer la base et construire la DATABASE_URL du backend.
# Optionnelles : valeur par défaut "tourism" pour chacune.
# Prises en compte uniquement à la création du volume pgdata (puis `docker compose down -v` pour réinitialiser).
# En cas de changement, adapter aussi la DATABASE_URL ci-dessous (usage local).
# Si le mot de passe contient des caractères spéciaux (@ : /), les encoder en URL dans DATABASE_URL.
# POSTGRES_USER=tourism
# POSTGRES_PASSWORD=tourism
# POSTGRES_DB=tourism

# --- API ---
# Vide : conversations conservées en mémoire du processus (perdues au redémarrage).
# En local avec `docker compose up db` : postgresql://tourism:tourism@localhost:5432/tourism
# Sous docker compose, cette valeur est ignorée : le compose la remplace par une URL pointant sur le service "db".
#   Sur Render : câblée automatiquement par render.yaml sur l'"Internal Database URL" de la base
#   (ce fichier n'est pas déployé).
DATABASE_URL=
# Taille max du pool de connexions PostgreSQL (optionnel, défaut : 10)
# DATABASE_POOL_MAX_SIZE=10
# Clé exigée dans l'en-tête X-API-Key des routes /api/v1 (vide : API ouverte, développement uniquement)
API_KEY=
# Origines autorisées (frontend), séparées par des virgules
CORS_ORIGINS=http://localhost:7860
# Interface et port d'écoute de l'API (optionnels, défaut : 0.0.0.0 / 8000)
# API_HOST=0.0.0.0
# API_PORT=8000
LOG_LEVEL=INFO

# --- Traçage LangSmith (optionnel) ---
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
